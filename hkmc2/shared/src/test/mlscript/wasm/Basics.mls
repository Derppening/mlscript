
:global
:wasm

false
//│ Wasm => 0


true
//│ Wasm => 1


2
//│ Wasm => 2


1 + 1
//│ Wasm => 2


let x = 0
x
//│ Wasm => 0


:ge
fun foo() = 42
foo
//│ ╔══[COMPILATION ERROR] Returning function instances is not supported
//│ ║  l.28: 	foo
//│ ╙──      	^^^


fun foo() = 42
foo()
//│ Wasm => 42


fun foo() = 42
foo() + foo()
//│ Wasm => 84


fun foo(x) = x + 1
foo(41)
//│ Wasm => 42


class Foo(val x)
new Foo(0)
//│ Wasm => [Object: null prototype] {}


class Foo(val a)
(new Foo(42)).Foo#a
//│ Wasm => 42
