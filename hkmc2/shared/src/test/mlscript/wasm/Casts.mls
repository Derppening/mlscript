//│ Wasm result:
//│ = {}

:noCheckCasts
fun test: Function = castToObj(new C)
//│ Wasm result:
//│ = {}

fun castToA[A](x: A): A = x
//│ Wasm result:
//│ = {}

:noCheckCasts
fun test: Function = castToA(123)
