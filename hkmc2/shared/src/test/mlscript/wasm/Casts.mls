// All comments in this file assume that an intrinsic `cast[T](val)` function exists to perform a
// downcast to `T` for `val`. MLscript currently does not have a surface-language syntax or
// function for casting between types.

:global
:wasm


// In this example, the function call is equivalent to `useBox(cast[Box](id(new Box(42))))`.
// The `:wat` output below shows this as a `ref.cast` to `(ref $Box)` applied to the result of `id`,
// which is what the round-trip through an unannotated `id` makes necessary.
// Note that `:noInline` is needed here (and below) to prevent `id` from being inlined and the coercion elided.
:noInline
:wat
class Box(val v: Int)
fun id(a) = a
fun useBox(b: Box): Int = b.v
useBox(id(new Box(42)))
//│ Wat:
//│ (module
//│   (type $TypeInfoBase (sub (struct (field $$tag i32) (field $$parent (ref null $TypeInfoBase)))))
//│   (type $Object (sub (struct (field $$typeinfo (mut (ref $TypeInfoBase))))))
//│   (type $Box (sub $Object (struct (field $$typeinfo (mut (ref $TypeInfoBase))) (field $v (mut (ref null i31))))))
//│   (type $Box_typeinfo (sub $TypeInfoBase (struct (field $$tag i32) (field $$parent (ref null $TypeInfoBase)))))
//│   (type $Box_init (func (param $this (ref $Box)) (param $v (ref null i31)) (result (ref $Box))))
//│   (type $Box_ctor (func (param $v (ref null i31)) (result (ref $Box))))
//│   (type $id (func (param $a (ref null any)) (result (ref null any))))
//│   (type $useBox (func (param $b (ref $Box)) (result (ref null i31))))
