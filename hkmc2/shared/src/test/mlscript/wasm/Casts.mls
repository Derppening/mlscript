// Similarly, the constructor call is `new Wrap(cast[Box](id(new Box(7))))`.
:noInline
:noCheckCasts
class Wrap(val b: Box)
fun readV(b: Box) = b.v
let w = new Wrap(id(new Box(7)))
readV(w.Wrap#b)
//│ Wasm result:
//│ = 7


// `inc(cast[Int](id(41)))`
:noInline
fun inc(n: Int) = n + 1
inc(id(41))
//│ Wasm result:
//│ = 42


// `set x = cast[Int](id(7))`
:noInline
fun setter(x: Int) =
  set x = id(7)
  x
setter(1)
//│ Wasm result:
//│ = 7


// A return coercion also wraps a call, whose result is then narrowed for `useBox`'s `Box` parameter.
fun anyBox(n: Int): Object = new Box(7)
fun narrowBox(n: Int): Box = anyBox(n)
useBox(narrowBox(0))
//│ Wasm result:
//│ = 7


// Guards the re-placement of a return coercion across a merged dispatcher: only `sccF` narrows
// (`sccG` widens, free), so entering at `sccF` can exit through `sccG`'s arm, and its coercion has to
// be re-placed on its own stub - else `useBox` receives a value that was never narrowed to `Box`.
// Unlike JS, Wasm does not erase casts, so a missing narrowing is observable here.
fun sccF(n: Int): Box = sccG(n)
fun sccG(n: Int): Object = if n <= 0 then new Box(42) else sccF(n - 1)
useBox(sccF(3))
//│ Wasm result:
//│ = 42


// An adapted example of the above, but with `Int31` and `Int32` instead.
// This will result in a compilation error as the two `Int{31,32}` types have no common representation, causing
// `TailRecOpt` to emit errors when inserting casts to reconcile the types, and `WatBuilder` to also emit errors since
// the types are incompatible.
:ge
fun sccF(): Int31 = wasm.ref.i31(sccG())
fun sccG(): Int32 = wasm.i31.get_s(sccF()) + wasm.i32.const(1)
//│ ═══[COMPILATION ERROR] Cannot use a value of type 'Unknown' at an unrelated type 'Int32'
//│ ═══[COMPILATION ERROR] Types 'Int31' and 'Int32' have no common representation
//│ ╔══[COMPILATION ERROR] Types 'Int31' and 'Int32' have no common representation
//│ ║  l.203: 	fun sccF(): Int31 = wasm.ref.i31(sccG())
//│ ╙──       	    ^^^^
//│ ╔══[COMPILATION ERROR] Types 'Int31' and 'Int32' have no common representation
//│ ║  l.204: 	fun sccG(): Int32 = wasm.i31.get_s(sccF()) + wasm.i32.const(1)
//│ ╙──       	    ^^^^
//│ ═══[COMPILATION ERROR] Types 'Int31' and 'Int32' have no common representation
//│ ═══[COMPILATION ERROR] Types 'Int31' and 'Int32' have no common representation
//│ ╔══[COMPILATION ERROR] Types 'Int31' and 'Int32' have no common representation
//│ ║  l.203: 	fun sccF(): Int31 = wasm.ref.i31(sccG())
//│ ╙──       	    ^^^^
//│ ╔══[COMPILATION ERROR] Types 'Int31' and 'Int32' have no common representation
//│ ║  l.204: 	fun sccG(): Int32 = wasm.i31.get_s(sccF()) + wasm.i32.const(1)
//│ ╙──       	    ^^^^
//│ ╔══[COMPILATION ERROR] Wasm function `sccF` expects result to have type `(ref null i31)`, but got `(ref null any)`
//│ ║  l.203: 	fun sccF(): Int31 = wasm.ref.i31(sccG())
//│ ╙──       	^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ╔══[COMPILATION ERROR] Wasm function `sccG` expects result to have type `i32`, but got `(ref null any)`
//│ ║  l.204: 	fun sccG(): Int32 = wasm.i31.get_s(sccF()) + wasm.i32.const(1)
//│ ╙──       	^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^


fun bar(m: Int32) =
  wasm.ref.i31(m)
//│ Wasm result:
//│ = {}

:fixme // Currently, `TailRecOpt` forgets erased types and mixes parameter lists without checking compatibility
fun foo(n: Int31) =
  if n > 0 do bar(wasm.i31.get_s(n - 1))
fun bar(m: Int32) =
  foo(wasm.ref.i31(m))
//│ ╔══[COMPILATION ERROR] Operand #1 of wasm intrinsic 'ref.i31' must be of type 'Int32'
//│ ║  l.238: 	  foo(wasm.ref.i31(m))
//│ ╙──       	                   ^
//│ ═══[COMPILATION ERROR] Cannot cast a Wasm value of type `i32` to `(ref null any)` in a different type hierarchy


// The class must be defined in this block: one from an earlier block has no `typeinfo` global
// registered, so no test can be emitted for it. That checked casts (the default) really replace the
// bare `ref.cast` with a runtime test is what the `:noCheckCasts` blocks below observe; here the
// test only has to pass.
class Crate(val v: Int)
fun useCrate(c: Crate): Int = c.v
useCrate(id(new Crate(42)))
//│ Wasm result:
//│ = 42


// `NotACrate` has a different field count, so it is a distinct struct and the `ref.cast` traps. The
// constructor must be properly applied for that to be what fails: an under-applied one throws first, with an
// opaque `[object Object]` that hides whether the cast was reached at all. `:noCheckCasts` keeps this the
// bare-`ref.cast` spelling; the checked default would replace it with a `typeinfo` test.
:noCheckCasts
:re
class Crate2(val v: Int)
class NotACrate(val w: Int, val x: Int)
fun useCrate2(c: Crate2): Int = c.v
useCrate2(id(new NotACrate(1, 2)))
//│ Wasm result:
//│ ═══[RUNTIME ERROR] RuntimeError: illegal cast


// With the same field count the two are structurally identical structs, so `ref.cast` cannot tell them
// apart and the narrowing silently succeeds (see the checked default in the next block, which can).
:noCheckCasts
class Crate2(val v: Int)
class NotACrate(val w: Int)
fun useCrate2(c: Crate2): Int = c.v
useCrate2(id(new NotACrate(1)))
//│ Wasm result:
//│ = 1


// The same two classes as the `:noCheckCasts` block above, which `ref.cast` could not tell apart. The
// checked default tests the `typeinfo` tag instead, which does distinguish them, and names the target
// type when the test fails.
:re
class Crate2(val v: Int)
class NotACrate(val w: Int)
fun useCrate2(c: Crate2): Int = c.v
useCrate2(id(new NotACrate(1)))
//│ Wasm result:
//│ ═══[RUNTIME ERROR] Cannot narrow a value to type 'Crate2'


// Boxing is an intrinsic and takes no runtime test on the way in: an `Int32` has nothing to test against.
wasm.ref.i31(wasm.i32.const(7))
//│ Wasm result:
//│ = 7


// The same value cannot round-trip through an untyped slot: `id` leaves its parameter and result unannotated.
// Unlike the unannotated-result case in `wasm/Basics.mls`, the value crosses in both directions, so it is
// rejected going in and coming out. `:noInline` keeps `id` in place; inlining elides the crossing.
:ge
:noInline
wasm.ref.i31(id(wasm.i32.const(7)))
//│ ╔══[COMPILATION ERROR] Cannot use a value of type 'Int32' at an unrelated type 'Unknown'
//│ ║  l.304: 	wasm.ref.i31(id(wasm.i32.const(7)))
//│ ╙──       	                ^^^^^^^^^^^^^^^^^
//│ ╔══[COMPILATION ERROR] Cannot use a value of type 'Unknown' at an unrelated type 'Int32'
//│ ║  l.304: 	wasm.ref.i31(id(wasm.i32.const(7)))
//│ ╙──       	             ^^^^^^^^^^^^^^^^^^^^^
//│ ═══[COMPILATION ERROR] Cannot cast a Wasm value of type `i32` to `(ref null any)` in a different type hierarchy
//│ ═══[COMPILATION ERROR] Operand #1 of wasm intrinsic 'ref.i31' must be of type 'Int32'


// A narrowing *to* `Object`, which `anyBox` above does not exercise: widening into an `Object` slot is
// free, so only an erased source makes the coercion real. `id` erases its argument, so the value has to be
// narrowed back to `Pack` on the way out, and that narrowing has to be one the backend can emit.
:noInline
class Pack(val v: Int)
fun unpack(p: Pack): Int = p.v
fun toObj(): Object = id(new Pack(7))
unpack(toObj())
//│ Wasm result:
//│ = 7


:e
fun test: Function = id
//│ ╔══[COMPILATION ERROR] Returning function instances is not supported
//│ ║  l.328: 	fun test: Function = id
//│ ╙──       	                     ^^

:fixme
fun test: Function = new Object
