//│ = 0

class Foo(val x)
if Foo(42) is Foo(a) then a else 1
//│ Wasm result:
//│ = 42

class Foo(val x)
if 1 is Foo(a) then a else 1
//│ Wasm result:
//│ = 1

class Bar(val y)
class Baz(val z)
if Baz(10) is
  Bar(a) then a
  Baz(b) then 1
  else 0
