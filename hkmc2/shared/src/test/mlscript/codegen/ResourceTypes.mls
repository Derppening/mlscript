:sir
:siret

//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ import "..." as Predef; end

class C()
class D()
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define C⁰ as class C² { constructor C¹ }; define D⁰ as class D² { constructor D¹ }; end


// The modifier reaches the IR as the `rsc` of the erased type.

fun f(x: rsc C) = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define f⁰ as fun f¹(x: rsc C²): ? { return x }; end

fun g(x: rsc? C) = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define g⁰ as fun g¹(x: rsc? C²): ? { return x }; end

fun h(x: C) = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define h⁰ as fun h¹(x: C²): ? { return x }; end


// A written arrow is consumed as the definition's parameter list, so what remains is
// the result type - the modifier describes the function rather than the result, and is
// stripped along with the arrow. `kControl` is the same shape without one; `kForall`
// puts a quantifier between the modifier and the arrow, and `kMaybe` uses `rsc?`.

fun k: rsc (C) -> C
fun k(x) = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define k⁰ as rsc fun k¹(x: ?): C² { return (x as! C²) }; end

fun kControl: (C) -> C
fun kControl(x) = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define kControl⁰ as fun kControl¹(x: ?): C² { return (x as! C²) }; end

fun kForall: rsc [A] -> (A) -> A
fun kForall(x) = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define kForall⁰ as rsc fun kForall¹(x: ?): ? { return x }; end

fun kMaybe: rsc? (C) -> C
fun kMaybe(x) = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define kMaybe⁰ as rsc? fun kMaybe¹(x: ?): C² { return (x as! C²) }; end

// Referencing each as a value carries the resource-ness its signature declared of the
// function itself, which its definition renders as a prefix. Narrowing names it too.

:ge
val kNarrowed: Str = k
//│ ╔══[COMPILATION ERROR] Cannot use a value of type 'rsc Function' at an unrelated type 'Str'
//│ ║  l.57: 	val kNarrowed: Str = k
//│ ╙──      	                     ^
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define kNarrowed⁰ as val kNarrowed¹: Str⁰ = k¹; end

:ge
val kControlNarrowed: Str = kControl
//│ ╔══[COMPILATION ERROR] Cannot use a value of type 'Function' at an unrelated type 'Str'
//│ ║  l.65: 	val kControlNarrowed: Str = kControl
//│ ╙──      	                            ^^^^^^^^
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define kControlNarrowed⁰ as val kControlNarrowed¹: Str⁰ = kControl¹; end

:ge
val kForallNarrowed: Str = kForall
//│ ╔══[COMPILATION ERROR] Cannot use a value of type 'rsc Function' at an unrelated type 'Str'
//│ ║  l.73: 	val kForallNarrowed: Str = kForall
//│ ╙──      	                           ^^^^^^^
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define kForallNarrowed⁰ as val kForallNarrowed¹: Str⁰ = kForall¹; end

:ge
val kMaybeNarrowed: Str = kMaybe
//│ ╔══[COMPILATION ERROR] Cannot use a value of type 'rsc? Function' at an unrelated type 'Str'
//│ ║  l.81: 	val kMaybeNarrowed: Str = kMaybe
//│ ╙──      	                          ^^^^^^
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define kMaybeNarrowed⁰ as val kMaybeNarrowed¹: Str⁰ = kMaybe¹; end

// An arrow the definition does not consume is its result, so a modifier on it describes
// the function the definition returns rather than the definition itself. A paramless
// `fun` consumes none, even though at block level it compiles to a nullary function.

fun resultRsc(x): rsc (C) -> C = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define resultRsc⁰ as fun resultRsc¹(x: ?): rsc Function⁰ { return (x as! rsc Function⁰) }; end

:ge
val resultRscNarrowed: Str = resultRsc
//│ ╔══[COMPILATION ERROR] Cannot use a value of type 'Function' at an unrelated type 'Str'
//│ ║  l.97: 	val resultRscNarrowed: Str = resultRsc
//│ ╙──      	                             ^^^^^^^^^
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define resultRscNarrowed⁰ as val resultRscNarrowed¹: Str⁰ = resultRsc¹; end

fun paramlessRsc: rsc (C) -> C
fun paramlessRsc = resultRsc(0)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define paramlessRsc⁰ as fun paramlessRsc¹(): rsc Function⁰ { return resultRsc¹(0) }; end



// Each parameter list of a curried definition compiles to a closure of its own, so a
// modifier on a later arrow marks the function a partial application returns:
// `curriedInner(a)` is a resource function, and `curriedOuter(a)` is not.

fun curriedInner: (C) -> rsc (C) -> C
fun curriedInner(x)(y) = y
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define curriedInner⁰ as fun curriedInner¹(x: ?)(y: ?): C² { return (y as! C²) }; end

fun curriedOuter: rsc (C) -> (C) -> C
fun curriedOuter(x)(y) = y
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define curriedOuter⁰ as rsc fun curriedOuter¹(x: ?)(y: ?): C² { return (y as! C²) }; end

fun useRscFn(g: rsc (C) -> C) = g
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define useRscFn⁰ as fun useRscFn¹(g: rsc Function⁰): ? { return g }; end

fun usePlainFn(g: (C) -> C) = g
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define usePlainFn⁰ as fun usePlainFn¹(g: Function⁰): ? { return g }; end

fun innerIntoRsc(a) = useRscFn(curriedInner(a))
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define innerIntoRsc⁰ as fun innerIntoRsc¹(a: ?): ? {
//│   let tmp: rsc Function⁰;
//│   set tmp = curriedInner¹(a);
//│   return useRscFn¹(tmp)
//│ };
//│ end

fun outerIntoPlain(a) = usePlainFn(curriedOuter(a))
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define outerIntoPlain⁰ as fun outerIntoPlain¹(a: ?): ? {
//│   let tmp: Function⁰;
//│   set tmp = curriedOuter¹(a);
//│   return usePlainFn¹(tmp)
//│ };
//│ end

:ge
fun outerIntoRsc(a) = useRscFn(curriedOuter(a))
//│ ╔══[COMPILATION ERROR] Cannot use a value of type 'Function' at an unrelated type 'rsc Function'
//│ ║  l.152: 	fun outerIntoRsc(a) = useRscFn(curriedOuter(a))
//│ ╙──       	                               ^^^^^^^^^^^^^^^
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define outerIntoRsc⁰ as fun outerIntoRsc¹(a: ?): ? {
//│   let tmp: Function⁰;
//│   set tmp = curriedOuter¹(a);
//│   return useRscFn¹(tmp)
//│ };
//│ end

:ge
fun innerIntoPlain(a) = usePlainFn(curriedInner(a))
//│ ╔══[COMPILATION ERROR] Cannot use a value of type 'rsc Function' at an unrelated type 'Function'
//│ ║  l.165: 	fun innerIntoPlain(a) = usePlainFn(curriedInner(a))
//│ ╙──       	                                   ^^^^^^^^^^^^^^^
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define innerIntoPlain⁰ as fun innerIntoPlain¹(a: ?): ? {
//│   let tmp: rsc Function⁰;
//│   set tmp = curriedInner¹(a);
//│   return usePlainFn¹(tmp)
//│ };
//│ end



// Inside the parameter list the modifier marks the parameter, so `l` itself is not
// a resource function. The parameter's own erased type is not visible here, as the
// definition's parameter list carries no annotation.

fun l: (rsc C) -> C
fun l(x) = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define l⁰ as fun l¹(x: ?): C² { return (x as! C²) }; end


// A signature with no arrow has none to strip the modifier with, so the modifier stays
// on the result type, even when the definition writes a parameter list of its own.

declare fun mkRsc: rsc C
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ end

fun getter: rsc C
fun getter = mkRsc
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define getter⁰ as fun getter¹(): rsc C² { return globalThis⁰.mkRsc⁰ }; end

fun noArrow: rsc C
fun noArrow(x) = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define noArrow⁰ as fun noArrow¹(x: ?): rsc C² { return (x as! rsc C²) }; end


// `Anything` follows the same rule as any other class.

fun m(x: Anything) = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define m⁰ as fun m¹(x: Unknown): ? { return x }; end

fun n(x: rsc Anything) = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define n⁰ as fun n¹(x: rsc Unknown): ? { return x }; end

fun n2(x: rsc? Anything) = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define n2⁰ as fun n2¹(x: rsc? Unknown): ? { return x }; end



// A union carries its members' resource-ness through the join: kept when they agree,
// and undetermined when they do not.

fun o(x: rsc C | rsc D) = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define o⁰ as fun o¹(x: rsc Object⁰): ? { return x }; end

fun p(x: rsc C | D) = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define p⁰ as fun p¹(x: rsc? Object⁰): ? { return x }; end


// A resource does not fit a bare `Anything` slot, exactly as it does not fit a
// bare `C` one - but it does fit `rsc? Anything`.

:ge
fun intoAny(x: rsc C) = m(x)
//│ ╔══[COMPILATION ERROR] Cannot use a value of type 'rsc C' at an unrelated type 'Unknown'
//│ ║  l.239: 	fun intoAny(x: rsc C) = m(x)
//│ ╙──       	                          ^
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define intoAny⁰ as fun intoAny¹(x: rsc C²): ? { return m¹(x) }; end

fun intoMaybeAny(x: rsc C) = n2(x)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define intoMaybeAny⁰ as fun intoMaybeAny¹(x: rsc C²): ? { return n2¹(x) }; end


// A join across the primitive/Object divide widens to `Unknown`.

fun v(x: Int | C) = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define v⁰ as fun v¹(x: Unknown): ? { return x }; end

fun w(x: rsc C | rsc Int) = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define w⁰ as fun w¹(x: rsc Unknown): ? { return x }; end


// Widening into `rsc?` is free; narrowing back out is checked.

fun useMaybe(x: rsc? C) = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define useMaybe⁰ as fun useMaybe¹(x: rsc? C²): ? { return x }; end

fun useRsc(x: rsc C) = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define useRsc⁰ as fun useRsc¹(x: rsc C²): ? { return x }; end

fun r(x: rsc C) = useMaybe(x)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define r⁰ as fun r¹(x: rsc C²): ? { return useMaybe¹(x) }; end

fun s(x: rsc? C) = useRsc(x)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define s⁰ as fun s¹(x: rsc? C²): ? { return useRsc¹((x as! rsc C²)) }; end


// In type-argument position the modifier is accepted, but type arguments are
// erased, so it does not reach the erased type. Generic resource-ness is future work.

class Box[A](value: A)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define Box⁰ as class Box² {
//│   private val value⁰: ?;
//│   constructor Box¹(value: ?) { set Box².this.value⁰ = value; end }
//│ };
//│ end

fun t(b: Box[rsc C]) = b
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define t⁰ as fun t¹(b: Box²): ? { return b }; end


// Coercing between `rsc` and non-`rsc` is rejected in both directions.

:ge
fun q(x: C) = useRsc(x)
//│ ╔══[COMPILATION ERROR] Cannot use a value of type 'C' at an unrelated type 'rsc C'
//│ ║  l.300: 	fun q(x: C) = useRsc(x)
//│ ╙──       	                     ^
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define q⁰ as fun q¹(x: C²): ? { return useRsc¹(x) }; end


// In expression position the modifier is not a type annotation at all, and is
// reported like any other annotation that has no effect there.

:w
fun u() = rsc 1
//│ ╔══[WARNING] This annotation has no effect.
//│ ╟── This annotation is not supported on integer literal terms.
//│ ║  l.312: 	fun u() = rsc 1
//│ ╙──       	              ^
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define u⁰ as fun u¹(): ? { return 1 }; end


// A module is a singleton, so it can never be refcounted and `rsc module M` is
// nonsense. It is rejected, but only incidentally: `Elaborator` unwraps `module` only
// when it is the outermost form of the signature, so the modifier hides it and the
// declaration reaches term position - hence a message about the declaration.

module M
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define M⁰ as class M¹ module M²; end

fun modOf: module M
fun modOf = M
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define modOf⁰ as fun modOf¹(): module M² { return M² }; end

:ge
fun rscModOf: rsc module M
fun rscModOf = M
//│ ╔══[COMPILATION ERROR] Illegal type declaration in term position.
//│ ║  l.336: 	fun rscModOf: rsc module M
//│ ╙──       	                  ^^^^^^^^
//│ ╔══[COMPILATION ERROR] Illegal type declaration in term position.
//│ ║  l.336: 	fun rscModOf: rsc module M
//│ ╙──       	                  ^^^^^^^^
//│ ╔══[COMPILATION ERROR] Expected a type, got ‹error›
//│ ║  l.336: 	fun rscModOf: rsc module M
//│ ╙──       	                  ^^^^^^^^
//│ ╔══[COMPILATION ERROR] Expected a type, got ‹error›
//│ ║  l.336: 	fun rscModOf: rsc module M
//│ ╙──       	                  ^^^^^^^^
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define rscModOf⁰ as fun rscModOf¹(): ? { return M² }; end
