// `Int` is represented as a host primitive, so it is a sibling of `Object` rather than one of its
// descendants: neither direction is a widening or a narrowing, and both are rejected.
:ge
fun useObj(o: Object) = o
fun useInt(n: Int) = n
fun f(o: Object, i: Int) =
  useObj(i)
  useInt(o)
//│ ╔══[COMPILATION ERROR] Cannot use a value of type 'Int' at an unrelated type 'Object'
//│ ║  l.395: 	  useObj(i)
//│ ╙──       	         ^
//│ ╔══[COMPILATION ERROR] Cannot use a value of type 'Object' at an unrelated type 'Int'
//│ ║  l.396: 	  useInt(o)
//│ ╙──       	         ^
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define useObj² as fun useObj³(o: Object⁰): ? {
//│   return o
//│ };
//│ define useInt⁰ as fun useInt¹(n: Int⁰): ? {
//│   return n
//│ };
//│ define f⁶ as fun f⁷(o: Object⁰, i: Int⁰): ? { do useObj³(i); return useInt¹(o) };
//│ end


// `Int31 <: Int`.
fun useInt31(n: Int31) = n
fun g(i: Int, i31: Int31) =
  useInt(i31)
  useInt31(i)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define useInt31⁰ as fun useInt31¹(n: Int31⁰): ? {
//│   return n
//│ };
//│ define g⁰ as fun g¹(i: Int⁰, i31: Int31⁰): ? {
//│   do useInt¹(i31);
//│   return useInt31¹((i as!! Int31⁰))
//│ };
//│ end


// Aliases are resolved at cast sites, so passing between `Foo` and `FooAlias` - or down a chain - is free.
// The erased type itself keeps the alias symbol and resolves it lazily, but `print` canonicalizes every erased type
// before rendering, so an alias always prints as its target.
class Foo(x: Int)
type FooAlias = Foo
type MyInt = Int
type MyInt2 = MyInt
val w: MyInt2 = 2
fun narrow(f: FooAlias): Foo = f
fun widen(f: Foo): FooAlias = f
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define narrow⁰ as fun narrow¹(f: Foo³): Foo³ {
//│   return f
//│ };
//│ define widen⁰ as fun widen¹(f: Foo³): Foo³ {
//│   return f
//│ };
//│ define Foo⁴ as class Foo³ {
//│   private val x¹: Int⁰;
//│   constructor Foo⁵(x: Int⁰) { set Foo³.this.x¹ = x; end }
//│ };
//│ define w⁰ as val w¹: Int⁰ = 2;
//│ end


// An alias to a primitive resolves the same way - notably without raising the `Unrelated` error a primitive
// mismatch would.
fun useI32(n: Int32): Int32 = n
type MyI32 = Int32
fun useMyI32(x: MyI32): Int32 = useI32(x)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define useI32⁰ as fun useI32¹(n: Int32): Int32 {
//│   return n
//│ };
//│ define useMyI32⁰ as fun useMyI32¹(x: Int32): Int32 { return useI32¹(x) };
//│ end


// An alias whose right-hand side does not resolve to a single type symbol behaves as the top type during
// hierarchy analysis. A cycle is such a case; a union is not, since it erases to its members' LUB.
type Cyclic = Cyclic
class P
class Q
type Union = P | Q
fun useCyclic(x: Cyclic): Cyclic = x
fun useUnion(x: Union): Union = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define useCyclic⁰ as fun useCyclic¹(x: Unknown): Unknown {
//│   return x
//│ };
//│ define useUnion⁰ as fun useUnion¹(x: Object⁰): Object⁰ {
//│   return x
//│ };
//│ define P⁰ as class P¹;
//│ define Q⁰ as class Q¹;
//│ end


class Base
class A extends Base
class B extends Base
fun threeOf(x: A | B | Base): Int = 0
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define threeOf⁰ as fun threeOf¹(x: Base⁰): Int⁰ {
//│   return 0
//│ };
//│ define Base¹ as class Base⁰;
//│ define A⁰ as class A¹ extends Base⁰ {};
//│ define B⁰ as class B¹ extends Base⁰ {};
//│ end


// Casts are decided against the collapsed slot type: `A | B` erases to `Base`, so only `A | B -> A` is a
// downcast.
fun takesBase(b: Base): () = ()
fun takesUnion(u: A | B): () = ()
fun takesSubtype(a: A): () = ()
fun unionIntoBase(x: A | B) = takesBase(x)
fun memberIntoUnion(a: A) = takesUnion(a)
fun baseIntoUnion(b: Base) = takesUnion(b)
fun unionIntoSubtype(x: A | B) = takesSubtype(x)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define takesBase⁰ as fun takesBase¹(b: Base⁰): Unit⁰ {
//│   return runtime⁰.Unit⁰
//│ };
//│ define takesUnion⁰ as fun takesUnion¹(u: Base⁰): Unit⁰ {
//│   return runtime⁰.Unit⁰
//│ };
//│ define takesSubtype⁰ as fun takesSubtype¹(a: A¹): Unit⁰ {
//│   return runtime⁰.Unit⁰
//│ };
//│ define unionIntoBase⁰ as fun unionIntoBase¹(x: Base⁰): ? {
//│   return takesBase¹(x)
//│ };
//│ define memberIntoUnion⁰ as fun memberIntoUnion¹(a: A¹): ? {
//│   return takesUnion¹(a)
//│ };
//│ define baseIntoUnion⁰ as fun baseIntoUnion¹(b: Base⁰): ? {
//│   return takesUnion¹(b)
//│ };
//│ define unionIntoSubtype⁰ as fun unionIntoSubtype¹(x: Base⁰): ? {
//│   return takesSubtype¹((x as!! A¹))
//│ };
//│ end


// The primitives are roots of the erased hierarchy, so a union mixing one with any distinct type - another
// primitive included - has no upper bound to erase to. The bodies do not read `x`: declaring such a slot is
// legal, only crossing it is not.
fun mixed(x: Int32 | Str) = 0
fun twoPrims(x: Int32 | Int64) = 0
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define mixed⁰ as fun mixed¹(x: ‹incompatible(Int32, Str⁰)›): ? {
//│   return 0
//│ };
//│ define twoPrims⁰ as fun twoPrims¹(x: ‹incompatible(Int32, Int64)›): ? { return 0 };
//│ end


// A third member keeps the pair that first had no upper bound, not the last one folded in.
fun mixedThree(x: Int32 | Str | Bool) = 0
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define mixedThree⁰ as fun mixedThree¹(x: ‹incompatible(Int32, Str⁰)›): ? { return 0 }; end


// The error lands where a value crosses the slot, not where the type is written: the LUB is computed inside
// `canonicalize`, which cannot report anything.
:ge
fun intoMixed(n: Int32) = mixed(n)
//│ ╔══[COMPILATION ERROR] Types 'Int32' and 'Str' have no common representation
//│ ║  l.558: 	fun intoMixed(n: Int32) = mixed(n)
//│ ╙──       	                                ^
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define intoMixed⁰ as fun intoMixed¹(n: Int32): ? { return mixed¹(n) }; end


// Widening fails too: an unrepresentable value cannot enter an `Object` slot either. Both errors are
// unlocated - `returnedTerm` passes no location to `castTo`, a pre-existing gap that affects every return.
:ge
fun outOfMixed(x: Int32 | Str): Str = x
fun mixedIntoObject(x: Int32 | Str): Object = x
//│ ═══[COMPILATION ERROR] Types 'Int32' and 'Str' have no common representation
//│ ═══[COMPILATION ERROR] Types 'Int32' and 'Str' have no common representation
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define outOfMixed⁰ as fun outOfMixed¹(x: ‹incompatible(Int32, Str⁰)›): Str⁰ {
//│   return x
//│ };
//│ define mixedIntoObject⁰ as fun mixedIntoObject¹(x: ‹incompatible(Int32, Str⁰)›): Object⁰ {
//│   return x
//│ };
//│ end


// `sccF`'s tail call is folded into the merged dispatcher, dropping its `as Int` coercion; entering at `sccF` can exit
// through `sccG`'s arm, so the coercion is re-placed on `sccF`'s stub.
:soir
fun sccF(): Int = sccG()
fun sccG(): Num = sccF() + 1
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define sccF⁰ as fun sccF¹(): Int⁰ {
//│   return (sccG⁰() as!! Int⁰)
//│ };
//│ define sccG¹ as fun sccG⁰(): Num⁰ {
//│   let tmp: Int⁰;
//│   set tmp = sccF¹();
//│   return (+⁰(tmp, 1) as!! Num⁰)
//│ };
//│ end
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ define sccF⁰ as fun sccF¹(): Int⁰ {
//│   let id: Int⁰, inlinedVal: Num⁰;
//│   set id = 0;
//│   block inlinedLbl:
//│     loop loopLabel:
//│       match id
//│         0 =>
//│           set id = 1;
//│           continue loopLabel
//│         1 =>
//│           let tmp: Int⁰;
//│           set tmp = sccF¹();
//│           set inlinedVal = (+⁰(tmp, 1) as!! Num⁰);
//│           break inlinedLbl
//│         else
//│           unreachable /* dispatch tag is always a merged member id */
//│       end
//│     unreachable /* Rest of abortive labelled block */
//│   return (inlinedVal as!! Int⁰)
//│ };
//│ define sccG¹ as fun sccG⁰(): Num⁰ {
//│   let id: Int⁰, inlinedVal: Num⁰;
//│   set id = 1;
//│   block inlinedLbl:
//│     loop loopLabel:
//│       match id
//│         0 =>
//│           set id = 1;
//│           continue loopLabel
//│         1 =>
//│           let tmp: Int⁰;
//│           set tmp = sccF¹();
//│           set inlinedVal = (+⁰(tmp, 1) as!! Num⁰);
//│           break inlinedLbl
//│         else
//│           unreachable /* dispatch tag is always a merged member id */
//│       end
//│     unreachable /* Rest of abortive labelled block */
//│   return inlinedVal
//│ };
//│ end


// Checks whether `annotLoop(n - 1)` still produces a tail call even though it is wrapped in a `Cast` node.
:js
@tailrec
fun annotLoop(n: Int): () = annotHelper(n)
fun annotHelper(n) = if n <= 0 then () else annotLoop(n - 1)
annotHelper(100000)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ @tailrec
//│ define annotLoop⁰ as fun annotLoop¹(n: Int⁰): Unit⁰ {
//│   return (annotHelper⁰(n) as!! Unit⁰)
//│ };
//│ define annotHelper¹ as fun annotHelper⁰(n: ?): ? {
//│   let scrut: ?, tmp: ?;
//│   set scrut = <=⁰(n, 0);
//│   match scrut
//│     true =>
//│       return runtime⁰.Unit⁰
//│     else
//│       set tmp = -⁰(n, 1);
//│       return annotLoop¹((tmp as!! Int⁰))
//│   end
//│ };
//│ return annotHelper⁰(100000)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————


// Checks whether the let-bound tail call `r` still produces a tail call even though it is wrapped in a `Cast` node.
// A dropped return coercion is re-placed on the stub of the function that dropped it.
:soir
:js
@tailrec
fun sccLoop(n: Int): Int =
  let r = sccHelper(n)
  r
fun sccHelper(n: Int): Num = if n <= 0 then 0 else sccLoop(n - 1)
sccHelper(100000)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ @tailrec
//│ define sccLoop⁰ as fun sccLoop¹(n: Int⁰): Int⁰ {
//│   let r: ?;
//│   set r = sccHelper⁰(n);
//│   return (r as!! Int⁰)
//│ };
//│ define sccHelper¹ as fun sccHelper⁰(n: Int⁰): Num⁰ {
//│   let scrut: ?, tmp: ?;
//│   set scrut = <=⁰(n, 0);
//│   match scrut
//│     true =>
//│       return 0
//│     else
//│       set tmp = -⁰(n, 1);
//│       return sccLoop¹((tmp as!! Int⁰))
//│   end
//│ };
//│ return sccHelper⁰(100000)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let sccLoop_sccHelper;
//│ define sccLoop_sccHelper as fun sccLoop_sccHelper⁰(id: Int⁰, param0: ?): Num⁰ {
//│   loop loopLabel:
//│     match id
//│       0 =>
//│         set id = 1;
//│         continue loopLabel
//│       1 =>
//│         let scrut: ?, tmp: ?;
//│         set scrut = <=⁰(param0, 0);
//│         match scrut
//│           true =>
//│             return 0
//│           else
//│             set tmp = -⁰(param0, 1);
//│             set param0 = (tmp as!! Int⁰);
//│             set id = 0;
//│             continue loopLabel
//│         end
//│       else
//│         unreachable /* dispatch tag is always a merged member id */
//│     end
//│   unreachable /* Rest of abortive labelled block */
//│ };
//│ @tailrec
//│ define sccLoop⁰ as fun sccLoop¹(n: Int⁰): Int⁰ {
//│   return (sccLoop_sccHelper⁰(0, n) as!! Int⁰)
//│ };
//│ define sccHelper¹ as fun sccHelper⁰(n: Int⁰): Num⁰ {
//│   return sccLoop_sccHelper⁰(1, n)
//│ };
//│ return sccLoop_sccHelper⁰(1, 100000)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 0


// Ensure that the surface `Anything` erases to `ErasedType.Unknown` and not `ErasedType.AnyRef(_, Anything)`
// (which is indicated by `Anything⁰`).
fun f(x: Anything): Anything = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define f⁸ as fun f⁹(x: Unknown): Unknown { return x }; end


// A call is typed as the callee's result only when saturated: `curried(1)` supplies one of two declared
// parameter lists, so it is the residual function, not an `Int`.
fun curried(a: Int)(b: Int): Int = a + b
fun useFn(g: Function) = g(1)
useFn(curried(1))
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let tmp: Function⁰;
//│ define curried⁰ as fun curried¹(a: Int⁰)(b: Int⁰): Int⁰ {
//│   return (+⁰(a, b) as!! Int⁰)
//│ };
//│ define useFn⁰ as fun useFn¹(g: Function⁰): ? {
//│   return g(1)
//│ };
//│ set tmp = curried¹(1);
//│ return useFn¹(tmp)


val done: Int = curried(1)(2)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let tmp: Int⁰; set tmp = curried¹(1)(2); define done⁰ as val done¹: Int⁰ = tmp; end


// Counting lists must account for normalization: a `fun` with no parameter list keeps `Nil` in its
// signature, but lowering gives it one empty list and calls it with one empty argument list. `thunk()` is
// therefore saturated, and only the further `(2)` needs narrowing to `Int`.
fun thunk: Function = (b: Int) => b + 1
val over: Int = thunk(2)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let tmp: Function⁰, tmp1: ?;
//│ define thunk⁰ as fun thunk¹(): Function⁰ {
//│   let lambda;
//│   @private
//│   define lambda as fun lambda⁰(b: Int⁰) {
//│     return +⁰(b, 1)
//│   };
//│   return (lambda⁰ as!! Function⁰)
//│ };
//│ set tmp = thunk¹();
//│ set tmp1 = tmp(2);
//│ define over⁰ as val over¹: Int⁰ = (tmp1 as!! Int⁰);
//│ end


// A saturated `thunk` keeps the type `Function`, so narrowing it to `Str` is an unrelated-types error. Read
// as over-applied instead, the result would take the top type and nothing would be raised - which is what
// makes the presence of this error, rather than its absence, the thing worth asserting.
:ge
val bad: Str = thunk
//│ ╔══[COMPILATION ERROR] Cannot use a value of type 'Function' at an unrelated type 'Str'
//│ ║  l.788: 	val bad: Str = thunk
//│ ╙──       	               ^^^^^
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let tmp: Function⁰; set tmp = thunk¹(); define bad² as val bad³: Str⁰ = tmp; end


// *No* parameter list must stay distinct from *one empty* one: only the former is auto-invoked, so a bare
// `called` is the function itself rather than its result, and narrowing it to `Str` is likewise an error.
:ge
fun called() = 3
val notCalled: Str = called
//│ ╔══[COMPILATION ERROR] Cannot use a value of type 'Function' at an unrelated type 'Str'
//│ ║  l.800: 	val notCalled: Str = called
//│ ╙──       	                     ^^^^^^
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define called⁰ as fun called¹(): ? {
//│   return 3
//│ };
//│ define notCalled⁰ as val notCalled¹: Str⁰ = called¹;
//│ end


// An instantiation is typed as its class, so it cannot fill a primitive slot. Were the `Instantiate` type
// lost, this would silently become an ordinary downcast instead of the error below.
:ge
fun badInst() = useInt(new Bar("x"))
//│ ╔══[COMPILATION ERROR] Cannot use a value of type 'Bar' at an unrelated type 'Int'
//│ ║  l.815: 	fun badInst() = useInt(new Bar("x"))
//│ ╙──       	                       ^^^^^^^^^^^^
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define badInst⁰ as fun badInst¹(): ? {
//│   let tmp: Bar⁰;
//│   set tmp = new Bar⁰("x");
//│   return useInt¹(tmp)
//│ };
//│ end


fun test: Function = id
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define test² as fun test³(): Function⁰ { return id¹ }; end

fun test: Function = new Object
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define test⁴ as fun test⁵(): Function⁰ { return (new globalThis⁰.Object⁰() as!! Function⁰) }; end


// A written arrow type erases to `Function`: a parameter so annotated is a function value, and a lambda flowing into
// it is cast into a `Function`. The parameter and return shapes are erased.
fun applyF(f: Int -> Int): Int = f(1)
applyF((x: Int) => x)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let lambda;
//│ define applyF⁰ as fun applyF¹(f: Function⁰): Int⁰ {
//│   return (f(1) as!! Int⁰)
//│ };
//│ define lambda as fun lambda¹(x: Int⁰) { return x };
//│ return applyF¹((lambda¹ as!! Function⁰))


// A result annotation that is a written arrow is likewise a function-typed result: `mk` returns a function value, so
// its body (a lambda) is typed as `Function`.
fun mk: Int -> Int = (x: Int) => x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define mk² as fun mk³(): Function⁰ {
//│   let lambda;
//│   @private
//│   define lambda as fun lambda²(x: Int⁰) { return x };
//│   return (lambda² as!! Function⁰)
//│ };
//│ end


// A non-function value is rejected where a `Function` value is expected.
:ge
fun badFn() = applyF(42)
//│ ╔══[COMPILATION ERROR] Cannot use a value of type 'Int' at an unrelated type 'Function'
//│ ║  l.865: 	fun badFn() = applyF(42)
//│ ╙──       	                     ^^
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define badFn⁰ as fun badFn¹(): ? { return applyF¹(42) }; end


// A `val` annotated with an arrow type has the function value as its type, just like a parameter.
val g: Int -> Int = (x: Int) => x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let lambda;
//│ define lambda as fun lambda³(x: Int⁰) {
//│   return x
//│ };
//│ define g² as val g³: Function⁰ = (lambda³ as!! Function⁰);
//│ end


// The simplifier propagates a cast literal to its use sites as the whole `Cast` node rather than as the bare
// literal, so the cast's target survives into the positions a backend reads off the value instead of off the
// slot - notably a `return`, which Wasm validates against the declared result rather than coercing into it.
// The price is that a `Cast` now sits between a literal and its consumers, so a consumer that wants the
// *literal* has to look through it (`Result.litThroughUncheckedCasts`); matching `Value.Lit` directly stops
// matching, silently.
// The two sites below are where that is a correctness matter rather than a lost optimization: without the
// look-through they emit `42.whoami` and `42.length`, which are syntax errors - the `.` parses as a decimal
// point. `fortyTwo` is deliberately unannotated so that the coercion into `asWrapper`'s parameter is a real
// narrowing, and `Wrapper` is never actually instantiated: only the emitted JS matters here.
:js
class Wrapper with
  val whoami = "wrapper"
fun fortyTwo = 42
fun asWrapper(x: Wrapper): Wrapper = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define fortyTwo⁰ as fun fortyTwo¹(): ? {
//│   return 42
//│ };
//│ define asWrapper⁰ as fun asWrapper¹(x: Wrapper⁰): Wrapper⁰ {
//│   return x
//│ };
//│ define Wrapper¹ as class Wrapper⁰ {
//│   val whoami⁰: ?;
//│   constructor() { define whoami⁰ as val whoami¹: ? = "wrapper"; end }
//│ };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

// A cast literal as a property-access receiver.
:js
:sjs
asWrapper(fortyTwo).whoami
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let tmp: ?, tmp1: Wrapper⁰;
//│ set tmp = fortyTwo¹();
//│ set tmp1 = asWrapper¹((tmp as!! Wrapper⁰));
//│ return tmp1.whoami¹
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ return (42).whoami
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

// A cast literal as a tuple-pattern scrutinee, whose test reads `.length` off it.
:js
:sjs
if asWrapper(fortyTwo) is
  [a, b] then "pair"
  else "other"
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let scrut: ?, a: ?, b: ?, element1$: ?, element0$: ?, tmp: ?;
//│ set tmp = fortyTwo¹();
//│ set scrut = asWrapper¹((tmp as!! Wrapper⁰));
//│ match scrut
//│   Array(2) =>
//│     set element0$ = runtime⁰.Tuple⁰.get²(scrut, 0);
//│     set element1$ = runtime⁰.Tuple⁰.get²(scrut, 1);
//│     set b = element1$;
//│     set a = element0$;
//│     return "pair"
//│   else
//│     return "other"
//│ end
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ if (runtime.Tuple.isArrayLike(42) && (42).length === 2) {
//│   runtime.Tuple.get(42, 0);
//│   runtime.Tuple.get(42, 1);
//│   return "pair"
//│ }
//│ return "other";
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = "other"


// A lifted function that refers to the enclosing class's `this` receives it as an auxiliary parameter. That parameter
// stands for the same slot as the `this` passed into it, so it takes the enclosing class's type.
:lift
class Box(content: Int) with
  fun unwrap() =
    fun peek() = this
    peek()
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let peek;
//│ define peek as fun peek⁰(Box: Box³): ? {
//│   return Box
//│ };
//│ define Box⁴ as class Box³ {
//│   private val content⁰: Int⁰;
//│   constructor Box⁵(content: Int⁰) {
//│     set Box³.this.content⁰ = content;
//│     end
//│   }
//│   method unwrap⁰ = fun unwrap¹(): ? { return peek⁰(Box³.this) }
//│ };
//│ end


// The same holds for a local `object` reached by name: the lifted function receives the object's symbol as an
// auxiliary parameter, typed with the object's own type.
:w
:lift
fun tagged(x: Int) =
  object Tag with
    fun label() = "tag"
  fun describe() = Tag.label()
  describe()
//│ ╔══[WARNING] Objects are not yet lifted.
//│ ║  l.985: 	  object Tag with
//│ ╙──       	         ^^^
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let describe;
//│ define describe as fun describe⁰(Tag: Tag⁰): ? {
//│   return Tag.label⁰()
//│ };
//│ define tagged⁰ as fun tagged¹(x: Int⁰): ? {
//│   let Tag;
//│   define Tag as object Tag⁰ {
//│     method label¹ = fun label⁰(): ? { return "tag" }
//│   };
//│   return describe⁰(Tag⁰)
//│ };
//│ end


// A lifted *class* takes its passed locals as constructor parameters and private fields, which are typed the same way.
:w
:lift
fun mk() =
  object Tag with
    fun label() = "tag"
  class Holder with
    fun get() = Tag.label()
  new Holder
//│ ╔══[WARNING] Objects are not yet lifted.
//│ ║  l.1011: 	  object Tag with
//│ ╙──        	         ^^^
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let Holder;
//│ define Holder as class Holder⁰ {
//│   private val Tag¹: Tag²;
//│   constructor(Tag: Tag²) {
//│     set Holder⁰.this.Tag¹ = Tag;
//│     end
//│   }
//│   method get³ = fun get⁴(): ? {
//│     return Holder⁰.this.Tag¹.label²()
//│   }
//│ };
//│ define mk⁴ as fun mk⁵(): ? {
//│   let Tag;
//│   define Tag as object Tag² {
//│     method label³ = fun label²(): ? { return "tag" }
//│   };
//│   return new Holder⁰(Tag²)
//│ };
//│ end


// A selection narrows its qualifier to the class declaring the member, so that the coercion lives in the IR
// instead of being re-derived by each backend. `a` is an untyped local, so the narrowing is not a no-op.
:sir
class Box(val v) with
  fun get() = v
let a = Box(1)
a.Box#v
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define Box⁶ as class Box⁸ {
//│   val v⁵: ?;
//│   constructor Box⁷(v: ?) {
//│     define v⁵ as val v⁶: ? = v;
//│     end
//│   }
//│   method get⁵ = fun get⁶(): ? { return Box⁸.this.v⁶ }
//│ };
//│ set a² = Box⁷(1);
//│ return (a² as!! Box⁸).v⁶


// The same rule reaches a method call's receiver (a call lowers to `Call(Select(qual, m), args)`) and the
// class-parameter bindings UCS synthesizes after a successful class test.
:sir
class Box(val v) with
  fun get() = v
fun peek(b) = if b is Box(x) then x else b.Box#get()
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define peek¹ as fun peek²(b: ?): ? {
//│   let x: ?, arg$Box$0$: ?;
//│   match b
//│     Box⁹ =>
//│       set arg$Box$0$ = (b as!! Box⁹).v⁷;
//│       set x = arg$Box$0$;
//│       return x
//│     else
//│       return (b as!! Box⁹).get⁷()
//│   end
//│ };
//│ define Box¹⁰ as class Box⁹ {
//│   val v⁸: ?;
//│   constructor Box¹¹(v: ?) {
//│     define v⁸ as val v⁷: ? = v;
//│     end
//│   }
//│   method get⁸ = fun get⁷(): ? { return Box⁹.this.v⁷ }
//│ };
//│ end
