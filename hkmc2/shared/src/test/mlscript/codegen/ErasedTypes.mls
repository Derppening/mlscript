//│   }
//│   method whatever⁰ = fun whatever¹(a: ?): ? { return a }
//│ };
//│ end


// A selection resolved to a member (`this.v`) still carries that member's annotated type.
class Box(val v: Int) with
  fun get() = v
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define Box⁰ as class Box² {
//│   val v³: Int⁰;
//│   constructor Box¹(v: Int⁰) {
//│     define v³ as val v⁴: Int⁰ = v;
//│     end
//│   }
//│   method get⁰ = fun get¹(): ? { return Box².this.v⁴ }
//│ };
//│ end


// Closure capture (`:lift`): the generated capture class and its field are not
// typed from the captured local, so they stay `: ?`.
:lift
fun counter(x: Int) =
  let n = 0
  fun bump() = set n = n + x
  bump()
  n
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let bump, Capture$scope0;
//│ define Capture$scope0 as class Capture$scope0¹ {
//│   constructor Capture$scope0⁰(n$0: ?) {
//│     define n$0⁰ as val n$0¹: ? = n$0;
//│     end
//│   }
//│ };
//│ define bump as fun bump⁰(scope0$cap: ?, x: Int⁰): ? {
//│   let tmp: ?;
//│   set tmp = +⁰(scope0$cap.n$0¹, x);
//│   set scope0$cap.n$0¹ = tmp;
//│   return runtime⁰.Unit⁰
//│ };
//│ define counter⁰ as fun counter¹(x: Int⁰): ? {
//│   let n: ?, scope0$cap: ?;
//│   set scope0$cap = new mut Capture$scope0¹(n);
//│   set scope0$cap.n$0¹ = 0;
//│   do bump⁰(scope0$cap, x);
//│   return scope0$cap.n$0¹
//│ };
//│ end


// When the captured slot keeps a definite erased type (the parameter `x` is annotated `Int`),
// the generated capture field inherits it: both the constructor parameter `x$0` and the
// `val x$0` field are typed `Int`, and the auxiliary parameter of the lifted function is
// typed as well. Without this, the capture class is untyped and the field reads are `?`.
:lift
fun resetCounter(x: Int): Int =
  fun reset() = set x = x + 1
  reset()
  x
resetCounter(41)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let reset, Capture$resetCounter;
//│ define reset as fun reset⁰(resetCounter$cap: ?): ? {
//│   let tmp: ?;
//│   set tmp = +⁰(resetCounter$cap.x$0⁰, 1);
//│   set resetCounter$cap.x$0⁰ = (tmp as!! Int⁰);
//│   return runtime⁰.Unit⁰
//│ };
//│ define Capture$resetCounter as class Capture$resetCounter¹ {
//│   constructor Capture$resetCounter⁰(x$0: Int⁰) {
//│     define x$0¹ as val x$0⁰: Int⁰ = x$0;
//│     end
//│   }
//│ };
//│ define resetCounter⁰ as fun resetCounter¹(x: Int⁰): Int⁰ {
//│   let resetCounter$cap: ?;
//│   set resetCounter$cap = new mut Capture$resetCounter¹(x);
//│   do reset⁰(resetCounter$cap);
//│   return resetCounter$cap.x$0⁰
//│ };
//│ return resetCounter¹(41)


// `Int32` is a root of the erased hierarchy rather than a descendant of `Object`, so neither direction is a
// widening or a narrowing - the same sibling relationship the `Int` block below describes. What separates
// the two: an `Int` is boxed and still reaches the top type, while an `Int32` cannot, which is the third
// error here, raised on the unannotated result of `f`.
:ge
fun useObj(o: Object) = o
fun useInt32(n: Int32): Int32 = n
fun f(x: Int32, o: Object) =
  useObj(x)
  useInt32(o)
//│ ╔══[COMPILATION ERROR] Cannot use a value of type 'Int32' at an unrelated type 'Object'
//│ ║  l.317: 	  useObj(x)
//│ ╙──       	         ^
//│ ╔══[COMPILATION ERROR] Cannot use a value of type 'Object' at an unrelated type 'Int32'
//│ ║  l.318: 	  useInt32(o)
//│ ╙──       	           ^
//│ ═══[COMPILATION ERROR] Cannot use a value of type 'Int32' at an unrelated type 'Unknown'
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define useObj⁰ as fun useObj¹(o: Object⁰): ? {
//│   return o
//│ };
//│ define useInt32⁰ as fun useInt32¹(n: Int32): Int32 {
//│   return n
//│ };
//│ define f² as fun f³(x: Int32, o: Object⁰): ? { do useObj¹(x); return useInt32¹(o) };
//│ end


// Similar to the above test case, but passing `Int32` into `Anything` instead of `Object`.
:ge
fun id(x: Anything) = ()
fun f(x: Int32) = id(x)
//│ ╔══[COMPILATION ERROR] Cannot use a value of type 'Int32' at an unrelated type 'Unknown'
//│ ║  l.340: 	fun f(x: Int32) = id(x)
//│ ╙──       	                     ^
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define id⁰ as fun id¹(x: Unknown): ? {
//│   return runtime⁰.Unit⁰
//│ };
//│ define f⁴ as fun f⁵(x: Int32): ? { return id¹(x) };
//│ end


// Passing `Int31` or `Int` to `id(Anything)` is legal, since `Anything` erased to `Unknown` (which is the top type for
// all reference types).
fun f1(x: Int31) = id(x)
fun f2(x: Int) = id(x)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define f1⁰ as fun f1¹(x: Int31⁰): ? {
//│   return id¹(x)
//│ };
//│ define f2⁰ as fun f2¹(x: Int⁰): ? { return id¹(x) };
//│ end


