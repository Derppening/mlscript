//│ };
//│ define add2⁰ as fun add2¹(x: Int⁰, y: Int⁰): Int⁰ { return (+⁰(x, y) as!! Int⁰) };
//│ end


// A parameter keeps its annotated type regardless of a later reassignment.
fun keep(x: Int) =
  set x = 5
  x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define keep⁰ as fun keep¹(x: Int⁰): ? { set x = 5; return x }; end


class Ref(mut val v: Int) with
  fun put(x) = set v = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define Ref⁰ as class Ref² {
//│   val v¹: Int⁰;
