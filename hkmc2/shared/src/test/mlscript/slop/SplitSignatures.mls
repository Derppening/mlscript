:.

// A signature written apart from its definition must precede it.
// A late signature is reported and ignored.


fun ok: Int -> Int
fun ok(x) = x
ok(1)
//│ = 1

// Elaborating the late declaration would make it the member's definition, so `late(1)` would call a function without
// parameters.
:e
fun late(x) = x
fun late: Int -> Int
late(1)
//│ ╔══[COMPILATION ERROR] The signature of 'late' must be written before its definition
//│ ║  l.+2: 	fun late: Int -> Int
//│ ║        	^^^^^^^^^^^^^^^^^^^^
//│ ╟── defined here
//│ ║  l.+1: 	fun late(x) = x
//│ ╙──      	^^^^^^^^^^^^^^^
//│ = 1

// The rule also applies when the definition has no parameters.
:e
fun lateGetter = 1
fun lateGetter: Int
lateGetter
//│ ╔══[COMPILATION ERROR] The signature of 'lateGetter' must be written before its definition
//│ ║  l.+2: 	fun lateGetter: Int
//│ ║        	^^^^^^^^^^^^^^^^^^^
//│ ╟── defined here
//│ ║  l.+1: 	fun lateGetter = 1
//│ ╙──      	^^^^^^^^^^^^^^^^^^
//│ = 1

:e
class C()
fun lateShadowing(C) = C
fun lateShadowing: C -> C
lateShadowing(C())
//│ ╔══[COMPILATION ERROR] The signature of 'lateShadowing' must be written before its definition
//│ ║  l.+3: 	fun lateShadowing: C -> C
//│ ║        	^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ╟── defined here
//│ ║  l.+2: 	fun lateShadowing(C) = C
//│ ╙──      	^^^^^^^^^^^^^^^^^^^^^^^^
//│ = C()

// The ignored signature does not constrain the definition.
:e
val lateVal = 1
val lateVal: Str
lateVal
//│ ╔══[COMPILATION ERROR] The signature of 'lateVal' must be written before its definition
//│ ║  l.+2: 	val lateVal: Str
//│ ║        	^^^^^^^^^^^^^^^^
//│ ╟── defined here
//│ ║  l.+1: 	val lateVal = 1
//│ ╙──      	^^^^^^^^^^^^^^^
//│ = 1
//│ lateVal = 1

:e
class K with
  fun k(x) = x
  fun k: Int -> Int
(new K).k(1)
//│ ╔══[COMPILATION ERROR] The signature of 'k' must be written before its definition
//│ ║  l.+3: 	  fun k: Int -> Int
//│ ║        	  ^^^^^^^^^^^^^^^^^
//│ ╟── defined here
//│ ║  l.+2: 	  fun k(x) = x
//│ ╙──      	  ^^^^^^^^^^^^
//│ = 1


// The definition elaborates its split signature once, without the definition's value parameters in scope.
:e
fun notFound: Foo -> Int
fun notFound(x) = x
//│ ╔══[COMPILATION ERROR] Name not found: Foo
//│ ║  l.+1: 	fun notFound: Foo -> Int
//│ ╙──      	              ^^^

class D()
fun paramNamedLikeClass: D -> D
fun paramNamedLikeClass(D) = D
paramNamedLikeClass(D())
//│ = D()

private fun bothPrivate: Int -> Int
private fun bothPrivate(x) = x
bothPrivate(1)
//│ = 1

:e
private fun privateSignature: Int -> Int
fun privateSignature(x) = x
//│ ╔══[COMPILATION ERROR] The signature and the definition of 'privateSignature' must have the same visibility
//│ ╟── signature here
//│ ║  l.+1: 	private fun privateSignature: Int -> Int
//│ ║        	^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ╟── definition here
//│ ║  l.+2: 	fun privateSignature(x) = x
//│ ╙──      	^^^^^^^^^^^^^^^^^^^^^^^^^^^

:e
fun privateDefinition: Int -> Int
private fun privateDefinition(x) = x
//│ ╔══[COMPILATION ERROR] The signature and the definition of 'privateDefinition' must have the same visibility
//│ ╟── signature here
//│ ║  l.+1: 	fun privateDefinition: Int -> Int
//│ ║        	^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ╟── definition here
//│ ║  l.+2: 	private fun privateDefinition(x) = x
//│ ╙──      	^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^

:e
declare fun declared: Int -> Int
fun declared(x) = x
//│ ╔══[COMPILATION ERROR] A 'declare'd signature cannot have a definition
//│ ║  l.+1: 	declare fun declared: Int -> Int
//│ ║        	^^^^^^^
//│ ╟── definition here
//│ ║  l.+2: 	fun declared(x) = x
//│ ╙──      	^^^^^^^^^^^^^^^^^^^

:e
fun annotatedResult: Int -> Int
fun annotatedResult(x): Int = x
//│ ╔══[COMPILATION ERROR] The definition of 'annotatedResult' cannot annotate its result type, as it has a separate signature
//│ ║  l.+2: 	fun annotatedResult(x): Int = x
//│ ║        	                        ^^^
//│ ╟── signature here
//│ ║  l.+1: 	fun annotatedResult: Int -> Int
//│ ╙──      	^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^

open annotations

// An annotation that only applies to an implementation belongs on the definition.
:e
@tailrec fun tailrecSignature: Int -> Int
fun tailrecSignature(x) = x
//│ ╔══[COMPILATION ERROR] This annotation must be written on the definition of 'tailrecSignature', not on its signature
//│ ║  l.+1: 	@tailrec fun tailrecSignature: Int -> Int
//│ ║        	^^^^^^^^
//│ ╟── definition here
//│ ║  l.+2: 	fun tailrecSignature(x) = x
//│ ╙──      	^^^^^^^^^^^^^^^^^^^^^^^^^^^

:e
fun tailrecDefinition: Int -> Int
@tailrec fun tailrecDefinition(x) = tailrecDefinition(x) + 1
//│ ╔══[COMPILATION ERROR] This function is marked @tailrec but is not tail recursive.
//│ ║  l.+2: 	@tailrec fun tailrecDefinition(x) = tailrecDefinition(x) + 1
//│ ║        	             ^^^^^^^^^^^^^^^^^
//│ ╟── It could self-recurse through this call, which is not a tail call.
//│ ║  l.+2: 	@tailrec fun tailrecDefinition(x) = tailrecDefinition(x) + 1
//│ ╙──      	                                    ^^^^^^^^^^^^^^^^^^^^


// The signature and the definition must be of the same kind.
:e
val valSignature: Int
fun valSignature = 1
//│ ╔══[COMPILATION ERROR] The signature and the definition of 'valSignature' must be of the same kind
//│ ╟── Value signature here
//│ ║  l.+1: 	val valSignature: Int
//│ ║        	^^^^^^^^^^^^^^^^^^^^^
//│ ╟── Function definition here
//│ ║  l.+2: 	fun valSignature = 1
//│ ╙──      	^^^^^^^^^^^^^^^^^^^^

:e
fun funSignature: Int
val funSignature = 1
//│ ╔══[COMPILATION ERROR] The signature and the definition of 'funSignature' must be of the same kind
//│ ╟── Function signature here
//│ ║  l.+1: 	fun funSignature: Int
//│ ║        	^^^^^^^^^^^^^^^^^^^^^
//│ ╟── Value definition here
//│ ║  l.+2: 	val funSignature = 1
//│ ╙──      	^^^^^^^^^^^^^^^^^^^^
//│ funSignature = 1

val bothVal: Int
val bothVal = 1
bothVal
//│ = 1
//│ bothVal = 1

// Type parameters written only on the signature are the definition's.
fun adopted[A]: A -> A
fun adopted(x) = x
adopted(1)
//│ = 1

fun sameTypeParams[A]: A -> A
fun sameTypeParams[A](x) = x
sameTypeParams(1)
//│ = 1

// After a type parameter mismatch, the signature is ignored, so its names cause no further errors.
:e
fun differentTypeParams[A]: A -> A
fun differentTypeParams[B](x) = x
//│ ╔══[COMPILATION ERROR] The signature and the definition of 'differentTypeParams' must have the same type parameters
//│ ╟── signature's type parameters
//│ ║  l.+1: 	fun differentTypeParams[A]: A -> A
//│ ║        	                        ^
//│ ╟── definition's type parameters
//│ ║  l.+2: 	fun differentTypeParams[B](x) = x
//│ ╙──      	                        ^

:e
fun moreTypeParams[A]: A -> A
fun moreTypeParams[A, B](x) = x
//│ ╔══[COMPILATION ERROR] The signature and the definition of 'moreTypeParams' must have the same type parameters
//│ ╟── signature's type parameters
//│ ║  l.+1: 	fun moreTypeParams[A]: A -> A
//│ ║        	                   ^
//│ ╟── definition's type parameters
//│ ║  l.+2: 	fun moreTypeParams[A, B](x) = x
//│ ╙──      	                   ^^^^

:e
fun definitionTypeParams: A -> A
fun definitionTypeParams[A](x) = x
//│ ╔══[COMPILATION ERROR] The type parameters of 'definitionTypeParams' must be written on its signature
//│ ║  l.+2: 	fun definitionTypeParams[A](x) = x
//│ ║        	                         ^
//│ ╟── signature here
//│ ║  l.+1: 	fun definitionTypeParams: A -> A
//│ ╙──      	^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^


// Class members follow the same rules.
:e
class Members with
  fun method: Int -> Int
  fun method(x) = x + 1
  fun getter: Int
  fun getter = 1
  private fun privateMember: Int -> Int
  fun privateMember(x) = x
let m = new Members
[m.method(1), m.getter]
//│ ╔══[COMPILATION ERROR] The signature and the definition of 'privateMember' must have the same visibility
//│ ╟── signature here
//│ ║  l.+6: 	  private fun privateMember: Int -> Int
//│ ║        	  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ╟── definition here
//│ ║  l.+7: 	  fun privateMember(x) = x
//│ ╙──      	  ^^^^^^^^^^^^^^^^^^^^^^^^
//│ = [2, 1]
//│ m = Members


