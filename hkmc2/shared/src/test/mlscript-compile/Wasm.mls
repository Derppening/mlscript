import "binaryen"

module Wasm with ...

// WebAssembly utilities
fun loadWasmBinary(modBuf): Promise =
  console.assert of WebAssembly.validate of modBuf

  val memory = new WebAssembly.Memory(initial: 100)
  val importObject =
    system:
      mem: memory

  WebAssembly.instantiate of modBuf, importObject

fun dumpWasmImpExp(wasmMod) =
  console.log of "Imports: %s", WebAssembly.Module.imports(wasmMod.module)
  console.log of "Exports: %s", WebAssembly.Module.exports(wasmMod.module)

// Binaryen helpers
fun binaryenFmtWat(wat, foldExprs): Promise =
  val mod = binaryen.parseText of wat
  mod.setFeatures(binaryen.Features.All)
  console.assert of mod.validate of mod

  val fmtWat = if foldExprs then mod.emitText() else mod.emitStackIR()

  mod.dispose()
  Promise.resolve(fmtWat)

fun binaryenCompileToModule(wat): Promise =
  val mod = binaryen.parseText of wat
  mod.setFeatures(binaryen.Features.All)

  console.assert of mod.validate of mod

  val modBuf = mod.emitBinary()
  mod.dispose()

  Promise.resolve(modBuf).then(modBuf =>
    loadWasmBinary of modBuf
  )

fun binaryenRunFunc(wat, func): Promise =
  binaryenCompileToModule(wat).then(wasmMod =>
    func(wasmMod.instance.exports)
  )
